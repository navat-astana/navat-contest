<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NAVAT — Регистрация</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: #f4efe6;
      color: #30291f;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 430px;
      background: #fffaf2;
      border-radius: 24px;
      padding: 32px 24px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    }

    .logo {
      text-align: center;
      font-size: 42px;
      font-weight: 800;
      letter-spacing: 5px;
      margin-bottom: 8px;
    }

    .subtitle {
      text-align: center;
      font-size: 15px;
      color: #776d60;
      margin-bottom: 30px;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      margin: 18px 0 8px;
    }

    input {
      width: 100%;
      padding: 15px;
      border: 1px solid #ded5c8;
      border-radius: 12px;
      background: white;
      font-size: 16px;
      outline: none;
    }

    input:focus {
      border-color: #9a876d;
    }

    button {
      width: 100%;
      margin-top: 25px;
      padding: 16px;
      border: 0;
      border-radius: 12px;
      background: #30291f;
      color: white;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
    }

    button:disabled {
      opacity: 0.6;
    }

    .result {
      display: none;
      text-align: center;
    }

    .success {
      font-size: 17px;
      margin-bottom: 20px;
    }

    .number {
      font-size: 64px;
      font-weight: 800;
      margin: 10px 0;
    }

    .error {
      color: #b3261e;
      font-size: 14px;
      margin-top: 12px;
      text-align: center;
    }
  </style>
</head>

<body>

<div class="container">

  <div id="registration">

    <div class="logo">NAVAT</div>

    <div class="subtitle">
      Регистрация участника
    </div>

    <form id="form">

      <label>ФИО</label>
      <input
        type="text"
        id="full_name"
        placeholder="Введите ФИО"
        required
      >

      <label>Номер телефона</label>
      <input
        type="tel"
        id="phone"
        placeholder="+7 700 000 00 00"
        required
      >

      <label>Instagram</label>
      <input
        type="text"
        id="instagram"
        placeholder="@username"
        required
      >

      <button type="submit" id="submitButton">
        УЧАСТВОВАТЬ
      </button>

      <div class="error" id="error"></div>

    </form>

  </div>

  <div class="result" id="result">

    <div class="logo">NAVAT</div>

    <div class="success">
      🎉 Регистрация завершена!
    </div>

    <div>
      Ваш номер участника
    </div>

    <div class="number" id="participantNumber">
      —
    </div>

    <div>
      Сохраните этот номер.
    </div>

  </div>

</div>

<script>

  const SUPABASE_URL = "https://wvcvpkccwvjtmlsgvcui.supabase.co/rest/v1/";
  const SUPABASE_KEY = "sb_publishable_m1eT92AFoxx5600HvlWkfw_zWVyCOdp";

  const form = document.getElementById("form");
  const button = document.getElementById("submitButton");
  const error = document.getElementById("error");

  form.addEventListener("submit", async function(e) {

    e.preventDefault();

    error.textContent = "";
    button.disabled = true;
    button.textContent = "РЕГИСТРАЦИЯ...";

    const fullName = document.getElementById("full_name").value.trim();
    const phone = document.getElementById("phone").value.trim();
    const instagram = document.getElementById("instagram").value.trim();

    try {

      const checkResponse = await fetch(
        `${SUPABASE_URL}/rest/v1/participants?select=participant_number&order=participant_number.desc&limit=1`,
        {
          headers: {
            "apikey": SUPABASE_KEY,
            "Authorization": `Bearer ${SUPABASE_KEY}`
          }
        }
      );

      if (!checkResponse.ok) {
        throw new Error("Ошибка подключения к базе");
      }

      const previous = await checkResponse.json();

      let nextNumber = 1;

      if (previous.length > 0 && previous[0].participant_number) {
        nextNumber = previous[0].participant_number + 1;
      }

      const saveResponse = await fetch(
        `${SUPABASE_URL}/rest/v1/participants`,
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json",
            "apikey": SUPABASE_KEY,
            "Authorization": `Bearer ${SUPABASE_KEY}`,
            "Prefer": "return=representation"
          },

          body: JSON.stringify({
            full_name: fullName,
            phone: phone,
            instagram: instagram,
            participant_number: nextNumber
          })
        }
      );

      if (!saveResponse.ok) {
        throw new Error("Не удалось сохранить регистрацию");
      }

      document.getElementById("registration").style.display = "none";
      document.getElementById("result").style.display = "block";

      document.getElementById("participantNumber").textContent =
        String(nextNumber).padStart(3, "0");

    } catch (err) {

      console.error(err);

      error.textContent =
        "Произошла ошибка. Попробуйте ещё раз.";

      button.disabled = false;
      button.textContent = "УЧАСТВОВАТЬ";
    }

  });

</script>

</body>
</html>
